FROM docker.io/nvidia/cuda:12.2.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    patch \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llama.cpp
RUN git clone https://github.com/ggml-org/llama.cpp.git . \
    && git fetch origin pull/27836/head \
    && git checkout -q 1d8de7c1b0c7d2febf8f983174d8e6a711e2b1af \
    && git submodule update --init --recursive

# Copy P100 patches plus local slot-checkpoint persistence fix (PR #26004)
COPY patches/p100/ /opt/p100-patches/

# Apply patches in order, zero fuzz, stop on first failure
RUN for p in /opt/p100-patches/*.patch; do \
        echo "Applying $(basename $p)..."; \
        patch -p1 -F 0 < "$p" || { echo "FAILED: $p"; exit 1; }; \
    done && echo "All patches applied."

RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:$LD_LIBRARY_PATH

RUN cmake -S . -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=86 \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_RPC=OFF \
    -DGGML_NATIVE=OFF \
    -DGGML_AVX=ON \
    -DGGML_AVX2=ON \
    -DGGML_FMA=ON \
    -DGGML_F16C=ON \
    -DGGML_AVX512=OFF \
    && cmake --build build --config Release -j$(nproc) \
    && cmake --install build --config Release

RUN mkdir -p /usr/local/lib/stubs \
    && find /opt/llama.cpp/build -type f -name 'lib*.so*' -exec cp {} /usr/local/lib/ \; \
    && cp /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/lib/stubs/libcuda.so.1 \
    && ldconfig

FROM docker.io/nvidia/cuda:12.2.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

LABEL com.github.containers.toolbox="true" \
      usage="This image is meant to be used with the toolbox command" \
      summary="RTX 3090 prefill: p100 chain + pr26004 + prefetch depth-N"

RUN apt-get update && apt-get install -y \
    sudo \
    libcap2-bin \
    libnss-myhostname \
    curl \
    libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/machine-id && touch /etc/machine-id \
    && userdel -r ubuntu || true \
    && sed -i 's/^hosts:.*/& myhostname/' /etc/nsswitch.conf

COPY --from=builder /usr/local/ /usr/local/

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf \
    && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
    && ldconfig

CMD ["/bin/bash"]

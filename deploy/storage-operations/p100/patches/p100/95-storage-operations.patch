diff --git a/tools/server/tests/storage-ops-registry-test.cpp b/tools/server/tests/storage-ops-registry-test.cpp
new file mode 100644
index 000000000..1fc2f1177
--- /dev/null
+++ b/tools/server/tests/storage-ops-registry-test.cpp
@@ -0,0 +1,96 @@
+// model-free test of server_storage_ops bounds, built and run by unit/test_storage_operations.py
+#include "../server-storage-ops.h"
+
+#include <iostream>
+#include <string>
+
+static int failures = 0;
+
+static void check(bool ok, const std::string & name) {
+    std::cout << (ok ? "PASS " : "FAIL ") << name << '\n';
+    failures += !ok;
+}
+
+static server_storage_op_key save_key(int id_slot, const std::string & filename) {
+    return { id_slot, "save", filename };
+}
+
+int main() {
+    int64_t now = 1000;
+
+    {
+        server_storage_ops ops;
+        ops.now_ms = [&] { return now; };
+        const auto k = save_key(0, "a.bin");
+        check(!ops.get(k).has_value(), "unknown before admit");
+        check(ops.admit(k) == SERVER_STORAGE_OP_ADMIT_OK, "admit");
+        check(ops.get(k)->status == SERVER_STORAGE_OP_QUEUED, "queued");
+        server_storage_op_status active = SERVER_STORAGE_OP_COMPLETED;
+        check(ops.admit(k, &active) == SERVER_STORAGE_OP_ADMIT_CONFLICT && active == SERVER_STORAGE_OP_QUEUED, "conflict while queued");
+        ops.set_running(k);
+        check(ops.get(k)->status == SERVER_STORAGE_OP_RUNNING, "running");
+        check(ops.admit(k, &active) == SERVER_STORAGE_OP_ADMIT_CONFLICT && active == SERVER_STORAGE_OP_RUNNING, "conflict while running");
+        ops.set_failed(k, "checkpoint_write_failed");
+        check(ops.get(k)->status == SERVER_STORAGE_OP_FAILED && ops.get(k)->error_code == "checkpoint_write_failed", "failed keeps error code");
+        ops.set_completed(k, "{}");
+        check(ops.get(k)->status == SERVER_STORAGE_OP_FAILED, "terminal state is final");
+        check(ops.admit(k) == SERVER_STORAGE_OP_ADMIT_OK && ops.get(k)->status == SERVER_STORAGE_OP_QUEUED, "terminal record replaced");
+        ops.set_completed(k, "{\"n_saved\":3}");
+        check(ops.get(k)->result_json == "{\"n_saved\":3}", "completed keeps result");
+        check(!ops.get({ 0, "restore", "a.bin" }).has_value(), "action is part of the identity");
+        check(!ops.get(save_key(1, "a.bin")).has_value(), "slot is part of the identity");
+    }
+
+    // retention: 1 hour for terminal records, outstanding records never expire
+    {
+        server_storage_ops ops;
+        ops.now_ms = [&] { return now; };
+        const auto done = save_key(0, "done.bin");
+        const auto pend = save_key(0, "pending.bin");
+        ops.admit(done);
+        ops.set_completed(done, "{}");
+        ops.admit(pend);
+        now += server_storage_ops::RETENTION_MS - 1;
+        check(ops.get(done).has_value(), "terminal kept before retention");
+        now += 1;
+        check(!ops.get(done).has_value(), "terminal expired after retention");
+        check(ops.get(pend).has_value() && ops.get(pend)->status == SERVER_STORAGE_OP_QUEUED, "outstanding never expires");
+    }
+
+    // at most 128 terminal records per slot, oldest terminal evicted first, outstanding never evicted
+    {
+        server_storage_ops ops;
+        ops.now_ms = [&] { return now; };
+        const auto pend = save_key(0, "pending.bin");
+        ops.admit(pend);
+        for (size_t i = 0; i < server_storage_ops::MAX_TERMINAL_PER_SLOT + 2; ++i) {
+            const auto k = save_key(0, "t" + std::to_string(i));
+            ops.admit(k);
+            ops.set_completed(k, "{}");
+        }
+        check(!ops.get(save_key(0, "t0")).has_value() && !ops.get(save_key(0, "t1")).has_value(), "oldest terminal evicted");
+        check(ops.get(save_key(0, "t2")).has_value(), "newer terminal kept");
+        check(ops.get(save_key(0, "t129")).has_value(), "newest terminal kept");
+        check(ops.get(pend).has_value(), "outstanding not evicted");
+        // other slots are independent
+        ops.admit(save_key(1, "x"));
+        ops.set_completed(save_key(1, "x"), "{}");
+        check(ops.get(save_key(1, "x")).has_value(), "per-slot bound");
+    }
+
+    // at most 128 outstanding per slot, rejected before admission
+    {
+        server_storage_ops ops;
+        ops.now_ms = [&] { return now; };
+        for (size_t i = 0; i < server_storage_ops::MAX_OUTSTANDING_PER_SLOT; ++i) {
+            ops.admit({ 0, "restore", "op" + std::to_string(i) });
+        }
+        check(ops.admit(save_key(0, "over")) == SERVER_STORAGE_OP_ADMIT_LIMIT, "outstanding limit");
+        check(!ops.get(save_key(0, "over")).has_value(), "rejected operation not recorded");
+        check(ops.admit(save_key(1, "other")) == SERVER_STORAGE_OP_ADMIT_OK, "limit is per slot");
+        ops.set_failed({ 0, "restore", "op0" }, "restore_failed");
+        check(ops.admit(save_key(0, "over")) == SERVER_STORAGE_OP_ADMIT_OK, "terminal frees outstanding quota");
+    }
+
+    return failures ? 1 : 0;
+}
diff --git a/tools/server/tests/unit/test_storage_operations.py b/tools/server/tests/unit/test_storage_operations.py
new file mode 100644
index 000000000..5a93fe84d
--- /dev/null
+++ b/tools/server/tests/unit/test_storage_operations.py
@@ -0,0 +1,418 @@
+import os
+import pathlib
+import shutil
+import subprocess
+import tempfile
+import threading
+import time
+
+import pytest
+import requests
+from utils import *
+
+# the save / restore handler blocks while <file>.hold exists, and a save fails before the checkpoint
+# appendix while <file>.fail-checkpoint exists; both only with LLAMA_SERVER_TEST_STORAGE_HOOKS set
+os.environ["LLAMA_SERVER_TEST_STORAGE_HOOKS"] = "1"
+
+SAVE_KEYS = {"id_slot", "filename", "n_saved", "n_written", "n_state_bytes", "checkpoints", "timings"}
+RESTORE_KEYS = {"id_slot", "filename", "n_restored", "n_read", "checkpoints", "timings"}
+ERASE_KEYS = {"id_slot", "n_erased"}
+
+server = ServerPreset.tinyllama2()
+
+
+@pytest.fixture(autouse=True)
+def create_server():
+    global server
+    server = ServerPreset.tinyllama2()
+    server.slot_save_path = "./tmp"
+    server.temperature = 0.0
+
+
+def url(path):
+    return f"http://{server.server_host}:{server.server_port}{path}"
+
+
+def slot_path(filename):
+    return os.path.join(server.slot_save_path, filename)
+
+
+def op_status(slot_id, action, **identity):
+    params = {"slot_id": slot_id, "action": action, **identity}
+    t0 = time.time()
+    res = requests.get(url("/storage-operations"), params=params, timeout=2)
+    elapsed = time.time() - t0
+    assert res.status_code == 200, res.text
+    body = res.json()
+    assert body["slot_id"] == slot_id
+    assert body["action"] == action
+    for k, v in identity.items():
+        assert body[k] == v
+    return body, elapsed
+
+
+def wait_status(slot_id, action, expected, timeout=20, **identity):
+    deadline = time.time() + timeout
+    while True:
+        body, _ = op_status(slot_id, action, **identity)
+        if body["status"] in expected:
+            return body
+        assert time.time() < deadline, f"status stayed {body['status']}, expected {expected}"
+        time.sleep(0.05)
+
+
+def fill_slot(id_slot):
+    res = server.make_request("POST", "/completion", data={
+        "prompt": "What is the capital of France?",
+        "id_slot": id_slot,
+        "cache_prompt": True,
+    })
+    assert res.status_code == 200
+
+
+class Hold:
+    def __init__(self, filename):
+        self.path = slot_path(filename) + ".hold"
+
+    def __enter__(self):
+        pathlib.Path(self.path).touch()
+        return self
+
+    def release(self):
+        if os.path.exists(self.path):
+            os.remove(self.path)
+
+    def __exit__(self, *args):
+        self.release()
+
+
+def post_async(path, data, timeout=60):
+    out = {}
+
+    def run():
+        try:
+            r = requests.post(url(path), json=data, timeout=timeout)
+            out["status_code"] = r.status_code
+            out["body"] = r.json()
+        except requests.exceptions.RequestException as e:
+            out["exception"] = e
+
+    t = threading.Thread(target=run)
+    t.start()
+    return t, out
+
+
+def test_registry_bounds_model_free():
+    cxx = shutil.which("g++") or shutil.which("c++")
+    if cxx is None:
+        pytest.skip("no C++ compiler")
+    src = pathlib.Path(__file__).resolve().parents[1] / "storage-ops-registry-test.cpp"
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = os.path.join(tmp, "registry-test")
+        subprocess.run([cxx, "-std=c++17", "-Wall", "-Wextra", "-Werror", str(src), "-o", exe], check=True)
+        res = subprocess.run([exe], capture_output=True, text=True)
+        print(res.stdout)
+        assert res.returncode == 0, res.stdout
+
+
+def test_unknown_lookup():
+    server.start()
+    body, _ = op_status(0, "save", filename="never-sent.bin")
+    assert body["status"] == "unknown"
+    body, _ = op_status(1, "restore", operation_id="never-sent")
+    assert body["status"] == "unknown"
+    body, _ = op_status(1, "erase", operation_id="never-sent")
+    assert body["status"] == "unknown"
+
+
+def test_lookup_bad_requests():
+    server.start()
+    for params in [
+        {"action": "save", "filename": "a"},
+        {"slot_id": "x", "action": "save", "filename": "a"},
+        {"slot_id": 0, "action": "bogus", "filename": "a"},
+        {"slot_id": 0, "action": "save"},
+        {"slot_id": 0, "action": "restore", "filename": "a"},
+    ]:
+        res = requests.get(url("/storage-operations"), params=params, timeout=2)
+        assert res.status_code == 400, params
+
+
+def test_save_completed_retains_original_response():
+    server.start()
+    fill_slot(1)
+    res = server.make_request("POST", "/slots/1?action=save", data={"filename": "op-save-1.bin"})
+    assert res.status_code == 200
+    assert set(res.body.keys()) == SAVE_KEYS
+    assert res.body["filename"] == "op-save-1.bin"
+    assert res.body["n_written"] == os.path.getsize(slot_path("op-save-1.bin"))
+
+    body, _ = op_status(1, "save", filename="op-save-1.bin")
+    assert body["status"] == "completed"
+    assert body["result"] == res.body
+    assert "error" not in body
+    assert "operation_id" not in body
+
+
+def test_restore_and_erase_tracked_by_operation_id():
+    server.start()
+    fill_slot(1)
+    res = server.make_request("POST", "/slots/1?action=save", data={"filename": "op-rs.bin"})
+    assert res.status_code == 200
+    saved = res.body
+
+    res = server.make_request("POST", "/slots/0?action=restore", data={"filename": "op-rs.bin", "operation_id": "restore-0001"})
+    assert res.status_code == 200
+    assert set(res.body.keys()) == RESTORE_KEYS
+    assert res.body["n_restored"] == saved["n_saved"]
+    body, _ = op_status(0, "restore", operation_id="restore-0001")
+    assert body["status"] == "completed"
+    assert body["result"] == res.body
+    assert "filename" not in body
+
+    res = server.make_request("POST", "/slots/0?action=erase", data={"operation_id": "erase-0001"})
+    assert res.status_code == 200
+    assert set(res.body.keys()) == ERASE_KEYS
+    body, _ = op_status(0, "erase", operation_id="erase-0001")
+    assert body["status"] == "completed"
+    assert body["result"] == res.body
+
+    # a failed tracked restore keeps only a bounded error code
+    res = server.make_request("POST", "/slots/0?action=restore", data={"filename": "missing.bin", "operation_id": "restore-0002"})
+    assert res.status_code == 400
+    body, _ = op_status(0, "restore", operation_id="restore-0002")
+    assert body["status"] == "failed"
+    assert body["error"] == "restore_failed"
+    assert "result" not in body
+
+
+def test_legacy_requests_unchanged_and_untracked():
+    server.server_slots = True
+    server.start()
+    fill_slot(1)
+    res = server.make_request("POST", "/slots/1?action=save", data={"filename": "legacy.bin"})
+    assert res.status_code == 200
+    assert set(res.body.keys()) == SAVE_KEYS
+    res = server.make_request("POST", "/slots/0?action=restore", data={"filename": "legacy.bin"})
+    assert res.status_code == 200
+    assert set(res.body.keys()) == RESTORE_KEYS
+    res = server.make_request("POST", "/slots/0?action=erase")
+    assert res.status_code == 200
+    assert set(res.body.keys()) == ERASE_KEYS
+
+    # plain GET /slots keeps its shape
+    res = server.make_request("GET", "/slots")
+    assert res.status_code == 200
+    assert isinstance(res.body, list) and len(res.body) == 2
+    for s in res.body:
+        assert "id" in s and "is_processing" in s
+        assert "storage_operations" not in s
+
+
+def test_polling_reads_running_while_save_blocked_then_queued_behind_it():
+    server.start()
+    fill_slot(1)
+    with Hold("blocked.bin") as hold:
+        t1, out1 = post_async("/slots/1?action=save", {"filename": "blocked.bin"})
+        body = wait_status(1, "save", {"running"}, filename="blocked.bin")
+        assert body["status"] == "running"
+
+        # the main loop is now blocked in the save handler, a second operation stays queued
+        t2, out2 = post_async("/slots/0?action=erase", {"operation_id": "erase-behind"})
+        body = wait_status(0, "erase", {"queued"}, operation_id="erase-behind")
+
+        # status reads stay fast while the disk operation is blocked
+        for _ in range(10):
+            body, elapsed = op_status(1, "save", filename="blocked.bin")
+            assert body["status"] == "running"
+            assert elapsed < 0.5
+            body, _ = op_status(0, "erase", operation_id="erase-behind")
+            assert body["status"] == "queued"
+            time.sleep(0.05)
+
+        hold.release()
+        t1.join(30)
+        t2.join(30)
+
+    assert out1["status_code"] == 200
+    body = wait_status(1, "save", {"completed"}, filename="blocked.bin")
+    assert body["result"] == out1["body"]
+    assert out2["status_code"] == 200
+    body = wait_status(0, "erase", {"completed"}, operation_id="erase-behind")
